# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 둘 다 비어 있으면 데모 모드로 실행됩니다.

# 11번가 OPEN API 센터(https://openapi.11st.co.kr) > API 관리에서 발급 (32자리)
# 키는 발급·갱신일로부터 180일 동안 유효합니다. 계속 쓰면 자동 연장됩니다.
ELEVENST_API_KEY=
# 발급·갱신한 날짜 (YYYY-MM-DD). 세션 시작 점검에서 만료까지 남은 날을 알려줍니다.
ELEVENST_KEY_ISSUED=

# 쿠팡 파트너스 > 파트너스 API (누적 판매 15만 원 이상 + 최종 승인 후 발급)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

PORT=8000
