# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 둘 중 하나만 있어도 동작하고, 둘 다 비어 있으면 데모 모드로 실행됩니다.

# 네이버 개발자센터 > 애플리케이션 등록 > 사용 API: "검색"
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쿠팡 파트너스 > 추가 기능 > Open API (최종 승인된 파트너만 발급 가능)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

PORT=8000
# 같은 검색어 결과를 몇 초 동안 재사용할지 (API 호출 한도 절약)
CACHE_SECONDS=600
